 ],
 "commands": [
  {
   "father": "trycatch",
   "description": "Control de ejecución",
   "children": [
    {
     "father": "group",
     "description": "HU002HU003HU004 - Inicializar el Asistente",
     "children": [
      {
       "father": "setVar",
       "var": "glbDicEstado",
       "command": "{'estado': 'ok', 'motivo_sin_casos': None, 'total_radicados': 0, 'motivo_detencion': ''}",
       "description": "Estado de la ejecución: estado, motivo si la selección queda vacía (HU-002), total de radicados y motivo de detención"
      },
      {
       "father": "setVar",
       "var": "glbArrIdsRadicados",
       "command": "[]",
       "description": "Radicados seleccionados por HU-002"
      },
      {
       "father": "setVar",
       "var": "glbArrIdsDescartados",
       "command": "[]",
       "description": "Radicados descartados por identificación ausente (HU-002)"
      },
      {
       "father": "setVar",
       "var": "glbArrAvanzan",
       "command": "[]",
       "description": "Radicados que avanzan a la validación de deuda (HU-004)"
      },
      {
       "father": "setVar",
       "var": "glbArrExcepcionesNegocioUno",
       "command": "[]",
       "description": "Radicados en excepción de negocio 1 (HU-004)"
      },
      {
       "father": "setVar",
       "var": "glbArrExcepcionesSistema",
       "command": "[]",
       "description": "Radicados en excepción de sistema (HU-003, HU-004)"
      },
      {
       "father": "execScriptPython",
       "description": "Carga los tres JSON de configuración, crea la estructura de carpetas y los dos logs del día",
       "command": "import sys\nraiz = GetVar('glbStrRutaRaiz')\nsys.path.insert(0, raiz + '/Scripts')\nfor nombre in [m for m in sys.modules if m == 'habeasdata' or m.startswith('habeasdata.')]:\n    del sys.modules[nombre]\nfrom habeasdata import pasos\nSetVar('glbDicInicio', pasos.iniciar(raiz))"
      },
      {
       "father": "execScriptPython",
       "description": "Lee los parámetros de negocio de la configuración (tipología, campo, literal de ausencia, lote, orden)",
       "command": "from habeasdata import pasos\nSetVar('glbDicParametros', pasos.parametros())"
      }
     ]
    },
    {
     "father": "trycatch",
     "description": "Proceso principal",
     "children": [
      {
       "father": "group",
       "description": "HU002 - Filtrar radicados de Exclusión de Datos",
       "children": [
        {
         "father": "execScriptPython",
         "description": "Solicita el token OAuth (client_credentials, vigencia 300 s); el secreto sale del Administrador de credenciales",
         "command": "from habeasdata import pasos\nSetVar('glbDicAutenticacion', pasos.solicitar_token())"
        },
        {
         "father": "evaluateIf",
         "description": "El token se obtuvo",
         "command": "{glbDicAutenticacion}[\"ok\"] == True",
         "children": [
          {
           "father": "setVar",
           "var": "locDicConsulta",
           "command": "{'base': {glbDicParametros}[\"negocio\"][\"CampoTipologia\"] + \" eq '\" + {glbDicParametros}[\"negocio\"][\"TipologiaExclusion\"] + \"'\", 'seleccion': {glbDicParametros}[\"negocio\"][\"CampoTipologia\"] + \" eq '\" + {glbDicParametros}[\"negocio\"][\"TipologiaExclusion\"] + \"'\", 'select': 'IDRADICADO,' + {glbDicParametros}[\"negocio\"][\"CampoTipologia\"], 'lote': {glbDicParametros}[\"seleccion\"][\"LoteMaximo\"], 'orden': {glbDicParametros}[\"seleccion\"][\"Orden\"]}",
           "description": "Arma la consulta de HU-002: filtro OData de la tipología ($filter, base de la selección), campos ($select), lote ($first) y orden ($orderby)"
          },
          {
           "father": "evaluateIf",
           "description": "Se descartan los radicados sin identificación (parámetro)",
           "command": "{glbDicParametros}[\"seleccion\"][\"DescartarIdentificacionAusente\"] == True",
           "children": [
            {
             "father": "setVar",
             "var": "locDicConsulta",
             "command": "dict({locDicConsulta}, seleccion={locDicConsulta}['base'] + \" and \" + {glbDicParametros}[\"seleccion\"][\"CampoIdentificacion\"] + \" ne '\" + {glbDicParametros}[\"seleccion\"][\"LiteralIdentificacionAusente\"] + \"'\")",
             "description": "Agrega al filtro: identificación distinta de «NO APORTA»"
            }
           ],
           "else": []
          },
          {
           "father": "execScriptPython",
           "description": "Consulta los radicados de exclusión (GET OData con $filter, $select, $first y $orderby)",
           "command": "from habeasdata import pasos\nSetVar('glbDicSeleccion', pasos.consultar_seleccion(GetVar('locDicConsulta')))"
          },
          {
           "father": "evaluateIf",
           "description": "La consulta respondió",
           "command": "{glbDicSeleccion}[\"ok\"] == True",
           "children": [
            {
             "father": "setVar",
             "var": "glbArrIdsRadicados",
             "command": "{glbDicSeleccion}[\"ids\"]",
             "description": "Guarda los radicados seleccionados"
            },
            {
             "father": "evaluateIf",
             "description": "Se descartan los radicados sin identificación (parámetro)",
             "command": "{glbDicParametros}[\"seleccion\"][\"DescartarIdentificacionAusente\"] == True",
             "children": [
              {
               "father": "setVar",
               "var": "locStrFiltroDescartados",
               "command": "{locDicConsulta}['base'] + \" and \" + {glbDicParametros}[\"seleccion\"][\"CampoIdentificacion\"] + \" eq '\" + {glbDicParametros}[\"seleccion\"][\"LiteralIdentificacionAusente\"] + \"'\"",
               "description": "Arma el filtro de los descartados: identificación igual a «NO APORTA»"
              },
              {
               "father": "execScriptPython",
               "description": "Consulta los radicados descartados para no perderlos en silencio",
               "command": "from habeasdata import pasos\nSetVar('glbDicDescartados', pasos.consultar_odata(GetVar('locStrFiltroDescartados'), 'IDRADICADO'))"
              },
              {
               "father": "evaluateIf",
               "description": "La consulta de descartados respondió",
               "command": "{glbDicDescartados}[\"ok\"] == True",
               "children": [
                {
                 "father": "setVar",
                 "var": "glbArrIdsDescartados",
                 "command": "{glbDicDescartados}[\"ids\"]",
                 "description": "Guarda los radicados descartados"
                },
                {
                 "father": "execScriptPython",
                 "description": "Deja los descartados en el log de auditoría y en el reporte",
                 "command": "from habeasdata import pasos\nSetVar('glbDicRegistroDescartados', pasos.registrar_descartados(GetVar('glbArrIdsDescartados')))"
                }
               ],
               "else": [
                {
                 "father": "setVar",
                 "var": "glbDicEstado",
                 "command": "dict({glbDicEstado}, estado='detenido', motivo_detencion={glbDicDescartados}[\"mensaje\"])",
                 "description": "Marca la ejecución como detenida y guarda el motivo del paso que falló"
                }
               ]
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "La selección quedó vacía y no hubo fallos",
             "command": "{glbDicEstado}['estado'] == 'ok' and len({glbArrIdsRadicados}) == 0",
             "children": [
              {
               "father": "execScriptPython",
               "description": "Consulta el total de radicados (consulta general, sin $filter)",
               "command": "from habeasdata import pasos\nSetVar('glbDicGeneral', pasos.consultar_odata('', 'IDRADICADO'))"
              },
              {
               "father": "evaluateIf",
               "description": "La consulta general respondió",
               "command": "{glbDicGeneral}[\"ok\"] == True",
               "children": [
                {
                 "father": "setVar",
                 "var": "glbDicEstado",
                 "command": "dict({glbDicEstado}, total_radicados=len({glbDicGeneral}[\"ids\"]))",
                 "description": "Total de radicados de la consulta general"
                },
                {
                 "father": "evaluateIf",
                 "description": "Todos los de la tipología fueron descartados",
                 "command": "len({glbArrIdsDescartados}) > 0",
                 "children": [
                  {
                   "father": "setVar",
                   "var": "glbDicEstado",
                   "command": "dict({glbDicEstado}, motivo_sin_casos='solo_descartados')",
                   "description": "Motivo: solo descartados"
                  }
                 ],
                 "else": [
                  {
                   "father": "evaluateIf",
                   "description": "Hay radicados, pero ninguno de la tipología",
                   "command": "{glbDicEstado}[\"total_radicados\"] > 0",
                   "children": [
                    {
                     "father": "setVar",
                     "var": "glbDicEstado",
                     "command": "dict({glbDicEstado}, motivo_sin_casos='tipologia_ausente')",
                     "description": "Motivo: tipología ausente"
                    }
                   ],
                   "else": [
                    {
                     "father": "setVar",
                     "var": "glbDicEstado",
                     "command": "dict({glbDicEstado}, motivo_sin_casos='bandeja_vacia')",
                     "description": "Motivo: bandeja vacía"
                    }
                   ]
                  }
                 ]
                },
                {
                 "father": "execScriptPython",
                 "description": "Registra «0 casos» y la cadencia del reintento (CADENCIA_REINTENTO_BANDEJA_VACIA)",
                 "command": "from habeasdata import pasos\nSetVar('glbDicSinCasos', pasos.registrar_sin_casos(pasos.objeto(GetVar('glbDicEstado'))['motivo_sin_casos'], pasos.objeto(GetVar('glbDicEstado'))['total_radicados']))"
                }
               ],
               "else": [
                {
                 "father": "setVar",
                 "var": "glbDicEstado",
                 "command": "dict({glbDicEstado}, estado='detenido', motivo_detencion={glbDicGeneral}[\"mensaje\"])",
                 "description": "Marca la ejecución como detenida y guarda el motivo del paso que falló"
                }
               ]
              }
             ],
             "else": []
            }
           ],
           "else": [
            {
             "father": "setVar",
             "var": "glbDicEstado",
             "command": "dict({glbDicEstado}, estado='detenido', motivo_detencion={glbDicSeleccion}[\"mensaje\"])",
             "description": "Marca la ejecución como detenida y guarda el motivo del paso que falló"
            }
           ]
          }
         ],
         "else": [
          {
           "father": "setVar",
           "var": "glbDicEstado",
           "command": "dict({glbDicEstado}, estado='detenido', motivo_detencion={glbDicAutenticacion}[\"mensaje\"])",
           "description": "Marca la ejecución como detenida y guarda el motivo del paso que falló"
          }
         ]
        }
       ]
      },
      {
       "father": "evaluateIf",
       "description": "Hay radicados que procesar",
       "command": "{glbDicEstado}['estado'] == 'ok' and len({glbArrIdsRadicados}) > 0",
       "children": [
        {
         "father": "for",
         "description": "Iteración por radicado de exclusión",
         "command": "{\"iterable\": \"{glbArrIdsRadicados}\", \"count\": 0}",
         "var": "locStrIdRadicado",
         "children": [
          {
           "father": "execScriptPython",
           "description": "Deja constancia del inicio del radicado en el log de auditoría",
           "command": "from habeasdata import pasos\nSetVar('locDicEvento', pasos.evento('Inicio del radicado ' + GetVar('locStrIdRadicado')))"
          },
          {
           "father": "group",
           "description": "HU003 - Leer datos paramétricos",
           "children": [
            {
             "father": "execScriptPython",
             "description": "Lee el radicado por IDRADICADO (GET individual)",
             "command": "from habeasdata import pasos\nSetVar('locDicLectura', pasos.leer_radicado(GetVar('locStrIdRadicado')))"
            },
            {
             "father": "evaluateIf",
             "description": "El radicado se pudo leer",
             "command": "{locDicLectura}[\"ok\"] == True",
             "children": [
              {
               "father": "execScriptPython",
               "description": "Limpia «No aporta» y vacíos (= ausente) y separa los valores de cada canal por «/»",
               "command": "from habeasdata import pasos\nSetVar('locDicPreparado', pasos.preparar_campos(GetVar('locDicLectura')))"
              },
              {
               "father": "execScriptPython",
               "description": "Clasifica cada teléfono por dígitos: celular, fijo o sin clasificar",
               "command": "from habeasdata import pasos\nSetVar('locDicCaso', pasos.clasificar_telefonos(GetVar('locDicPreparado')))"
              }
             ],
             "else": [
              {
               "father": "execScriptPython",
               "description": "Registra la excepción de sistema del radicado (log de errores y reporte)",
               "command": "from habeasdata import pasos\npasos.registrar_excepcion_sistema(GetVar('locStrIdRadicado'), pasos.objeto(GetVar('locDicLectura'))['mensaje'])"
              },
              {
               "father": "setVar",
               "var": "glbArrExcepcionesSistema",
               "command": "{glbArrExcepcionesSistema} + ['{locStrIdRadicado}']",
               "description": "Anota el radicado en excepciones de sistema"
              }
             ]
            }
           ]
          },
          {
           "father": "group",
           "description": "HU004 - Validar campos obligatorios",
           "children": [
            {
             "father": "setVar",
             "var": "locArrMotivos",
             "command": "[]",
             "description": "Lista de motivos de incompletitud (vacía al empezar cada radicado)"
            },
            {
             "father": "evaluateIf",
             "description": "Falta el nombre del cliente",
             "command": "{locDicLectura}[\"ok\"] == True and {locDicCaso}[\"nombre\"] is None",
             "children": [
              {
               "father": "setVar",
               "var": "locArrMotivos",
               "command": "{locArrMotivos} + ['NOMBRE DEL CLIENTE']",
               "description": "Agrega el motivo"
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "Falta el tipo de identificación",
             "command": "{locDicLectura}[\"ok\"] == True and {locDicCaso}[\"tipo_identificacion\"] is None",
             "children": [
              {
               "father": "setVar",
               "var": "locArrMotivos",
               "command": "{locArrMotivos} + ['TIPO DE IDENTIFICACION']",
               "description": "Agrega el motivo"
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "Falta el número de identificación",
             "command": "{locDicLectura}[\"ok\"] == True and {locDicCaso}[\"numero_identificacion\"] is None",
             "children": [
              {
               "father": "setVar",
               "var": "locArrMotivos",
               "command": "{locArrMotivos} + ['NUMERO DE IDENTIFICACION']",
               "description": "Agrega el motivo"
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "No hay ningún canal de contacto (ni correo ni teléfono)",
             "command": "{locDicLectura}[\"ok\"] == True and not {locDicCaso}[\"canal_correo\"] and not {locDicCaso}[\"canal_telefono\"]",
             "children": [
              {
               "father": "setVar",
               "var": "locArrMotivos",
               "command": "{locArrMotivos} + ['SIN CANAL DE CONTACTO']",
               "description": "Agrega el motivo"
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "El caso está completo",
             "command": "{locDicLectura}[\"ok\"] == True and len({locArrMotivos}) == 0",
             "children": [
              {
               "father": "execScriptPython",
               "description": "Registra el avance a la validación de deuda en el reporte",
               "command": "from habeasdata import pasos\nSetVar('locDicResultado', pasos.registrar_avance(GetVar('locDicCaso')))"
              },
              {
               "father": "setVar",
               "var": "glbArrAvanzan",
               "command": "{glbArrAvanzan} + ['{locStrIdRadicado}']",
               "description": "Anota el radicado en los que avanzan"
              }
             ],
             "else": []
            },
            {
             "father": "evaluateIf",
             "description": "El caso está incompleto: excepción de negocio 1",
             "command": "{locDicLectura}[\"ok\"] == True and len({locArrMotivos}) > 0",
             "children": [
              {
               "father": "execScriptPython",
               "description": "Escribe el comentario de la excepción de negocio 1 en Gestión → Detalle",
               "command": "from habeasdata import pasos\nSetVar('locDicComentario', pasos.comentar_excepcion_1(GetVar('locDicCaso'), GetVar('locArrMotivos')))"
              },
              {
               "father": "evaluateIf",
               "description": "El comentario quedó registrado",
               "command": "{locDicComentario}[\"ok\"] == True",
               "children": [
                {
                 "father": "execScriptPython",
                 "description": "Registra la excepción de negocio 1 en el reporte",
                 "command": "from habeasdata import pasos\nSetVar('locDicResultado', pasos.registrar_excepcion_negocio_1(GetVar('locDicCaso'), GetVar('locArrMotivos')))"
                },
                {
                 "father": "setVar",
                 "var": "glbArrExcepcionesNegocioUno",
                 "command": "{glbArrExcepcionesNegocioUno} + ['{locStrIdRadicado}']",
                 "description": "Anota el radicado en excepciones de negocio 1"
                }
               ],
               "else": [
                {
                 "father": "execScriptPython",
                 "description": "Registra la excepción de sistema (no se pudo escribir el comentario)",
                 "command": "from habeasdata import pasos\npasos.registrar_excepcion_sistema(GetVar('locStrIdRadicado'), pasos.objeto(GetVar('locDicComentario'))['mensaje'])"
                },
                {
                 "father": "setVar",
                 "var": "glbArrExcepcionesSistema",
                 "command": "{glbArrExcepcionesSistema} + ['{locStrIdRadicado}']",
                 "description": "Anota el radicado en excepciones de sistema"
                }
               ]
              }
             ],
             "else": []
            }
           ]
          },
          {
           "father": "execScriptPython",
           "description": "Deja constancia del fin del radicado en el log de auditoría",
           "command": "from habeasdata import pasos\nSetVar('locDicEvento', pasos.evento('Fin del radicado ' + GetVar('locStrIdRadicado')))"
          }
         ]
        }
       ],
       "else": []
      }
     ],
     "else": [
      {
       "father": "setVar",
       "var": "glbBlnEstadoSistema",
       "command": "False",
       "description": "Marca fallo de sistema en el proceso principal"
      },
      {
       "father": "setVar",
       "var": "glbDicEstado",
       "command": "dict({glbDicEstado}, estado='detenido')",
       "description": "Estado de la ejecución: detenido por excepción de sistema"
      }
     ]
    },
    {
     "father": "group",
     "description": "HU002HU003HU004 - Cierre y registro de ejecución",
     "children": [
      {
       "father": "evaluateIf",
       "description": "La ejecución se detuvo",
       "command": "{glbDicEstado}['estado'] == 'detenido'",
       "children": [
        {
         "father": "execScriptPython",
         "description": "Registra la detención en el log de errores y prepara el aviso «Detenido»",
         "command": "from habeasdata import pasos\nSetVar('glbDicDetencion', pasos.registrar_detencion(pasos.objeto(GetVar('glbDicEstado'))['motivo_detencion']))"
        },
        {
         "father": "setVar",
         "var": "glbStrAsuntoAviso",
         "command": "{glbDicDetencion}[\"notificacion\"][\"asunto\"]",
         "description": "Asunto del aviso que se enviará al equipo técnico"
        }
       ],
       "else": []
      },
      {
       "father": "execScriptPython",
       "description": "Cierra la ejecución y deja el resumen sin PII (en modo real los datos personales se enmascaran)",
